{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "adilazhari/laravel-trace",
    "description": "Application-level tracing for Laravel applications.",
    "keywords": [
        "laravel",
        "adilazhari",
        "laravel-trace"
    ],
    "homepage": "https://github.com/adilazhari/laravel-trace",
    "license": "MIT",
    "authors": [
        {
            "name": "Adil Azhari",
            "email": "adilazhariosman@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0",
        "psr/http-message": "^1.1||^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/agent-detector": "^2.0",
        "laravel/chisel": "^0.1",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "laravel/prompts": "^0.3",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.6"
    },
  "autoload": {
    "psr-4": {
      "AdilAzhari\\LaravelTrace\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AdilAzhari\\LaravelTrace\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "vendor/bin/pest"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
              "AdilAzhari\\LaravelTrace\\LaravelTraceServiceProvider"
            ],
            "aliases": {
              "LaravelTrace": "AdilAzhari\\LaravelTrace\\Facades\\LaravelTrace"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
