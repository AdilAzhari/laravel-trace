parameters:
    level: 7
    paths:
        - src
        - config
        - database
        - routes
    # This is a package: its config file lives at <package root>/config, not
    # the host application's config_path(), which Larastan's env()-outside-
    # of-config check defaults to and which does not exist during a plain
    # `phpstan analyse` run here.
    configDirectories:
        - config
    tmpDir: build/phpstan
